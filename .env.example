# Example settings. `make init` creates .env from scratch: it fills in every empty value below with a new
# random one (passwords, keys) or a local default. Never commit .env.
#
# Where the portal is reached. Local default: http://localhost:18090 (RP_ID localhost, for passkeys).
PUBLIC_ORIGIN=
RP_ID=
GATEWAY_PORT=
# Group id that may use the Docker socket (make init detects it), for the read-only docker-api proxy.
DOCKER_GID=
MASTER_KEY=
IDENTITY_DB_PASSWORD=
REGISTRY_DB_PASSWORD=
JISR_DB_PASSWORD=
CONSENT_DB_PASSWORD=
BANK_DB_PASSWORD=
EDUCATION_DB_PASSWORD=
HEALTH_DB_PASSWORD=
LABOR_DB_PASSWORD=
PROPERTY_DB_PASSWORD=
# true (local use): the sign-in page lists the demo citizens and their shared password.
# A public deployment sets false: the password is then known only to whoever holds .env.
DEMO_MODE=true
DEMO_PASSWORD=
# The automated tests' own staff account (signs in only with a server-minted test ticket).
TEST_STAFF_PASSWORD=
# Jisr runs as a database user that may only read and append the audit log.
JISR_APP_DB_PASSWORD=
# One key per caller of the notifier (Mithaq: codes and news only; ops: alerts, anchors, backups).
NOTIFIER_KEY_MITHAQ=
NOTIFIER_KEY_OPS=
ADMIN_PASSWORD=
CLERK_PASSWORD=
# Telegram (optional). Leave both empty for console mode: every one-time code and alert is printed by
# `docker compose logs -f notifier` instead of being sent. To use Telegram, put your own bot token and chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public age key for backups (make backup-key); the private key stays outside the project.
BACKUP_AGE_RECIPIENT=
# Native apps (optional): iOS "TEAMID.bundle.id" list, Android package + signing certificate SHA-256 (AA:BB:…)
IOS_APP_IDS=
ANDROID_APP_PACKAGE=
ANDROID_CERT_SHA256=
